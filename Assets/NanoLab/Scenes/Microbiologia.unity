  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3081c004046b31d46ab9172e75307060, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  ventana: {fileID: 854020796}
  titulo: {fileID: 1583716350}
  texto: {fileID: 112581186}
  contador: {fileID: 1816973413}
  etiquetaSiguiente: {fileID: 368365331}
  puntos:
  - {fileID: 961636681}
  - {fileID: 784783663}
  - {fileID: 581568198}
  - {fileID: 337997780}
  - {fileID: 1399360777}
  - {fileID: 1215857417}
  - {fileID: 1211089618}
  atras: {fileID: 35168845}
  siguiente: {fileID: 456161884}
  saltar: {fileID: 1460907479}
  insignia: {fileID: 1718915461}
  reabrir: {fileID: 1385556608}
  distancia: 0.7
  bajoOjos: 0.12
  distanciaRecolocar: 2.2
  pegadaACamara: 1
  suavidad: 5
  colorCristal: {r: 0.55, g: 0.82, b: 1, a: 0.16}
  contornoTexto: {r: 0, g: 0.06, b: 0.12, a: 0.85}
  pasos:
  - titulo: "\xA1HOLA! ERES BAYMAX"
    texto: "Eres <b>Baymax</b>, un peque\xF1o robot asistente de salud. En NanoLab
      VR no lo miras desde fuera: <b>t\xFA eres Baymax</b>. Sus manos son tus manos
      y, en el espejo, ver\xE1s su cuerpo moverse contigo."
  - titulo: PERDISTE TUS RECUERDOS
    texto: "Baymax ha perdido sus <b>recuerdos cient\xEDficos</b>. Para recuperarlos
      tendr\xE1s que investigar muestras como un microbi\xF3logo. Cada misi\xF3n
      te devuelve uno: <b>1</b> OBSERVAR muestras, <b>2</b> EXPERIMENTAR qu\xE9 las
      detiene y <b>3</b> CREAR una vacuna. Hay <color=#FFD25A><b>3</b></color> por
      recuperar."
  - titulo: EL OBJETIVO DE NANOLAB VR
    texto: "La mayor\xEDa de los microorganismos <b>no se ven a simple vista</b>.
      NanoLab VR es un laboratorio virtual para <b>explorar, observar y experimentar</b>
      con bacterias y virus, repetir cuantas veces quieras y aprender de tus decisiones.\n<size=80%><color=#A9BED2><i>Complemento
      educativo: las muestras y resultados est\xE1n simplificados; no son protocolos
      reales.</i></color></size>"
  - titulo: "C\xD3MO SE INVESTIGA"
    texto: "Cada caso sigue el ciclo del m\xE9todo cient\xEDfico:\n<color=#5FD3FF><b>Explorar
      \xB7 Observar \xB7 Investigar \xB7 Hip\xF3tesis \xB7 Experimentar \xB7 Analizar</b></color>\nLas
      pistas te orientan, pero <b>las decisiones son tuyas</b>. Si te equivocas recibes
      una pista y puedes volver a intentarlo."
  - titulo: CONTROLES
    texto: "<b>Joystick izquierdo:</b> caminar  \xB7  <b>derecho:</b> girar\n<b>Grip
      o gatillo:</b> agarrar objetos (tambi\xE9n con el rayo)\n<b>Botones:</b> t\xF3calos
      con la mano o ap\xFAntalos con el rayo y pulsa el gatillo\n<b>X:</b> continuar
      en esta ventana  \xB7  <b>Bot\xF3n men\xFA (mando izq.):</b> volumen, modo
      sentado y checkpoint"
  - titulo: "M\xCDRATE EN EL ESPEJO"
    texto: "Gira hacia el <color=#FFD25A><b>ESPEJO de tu derecha</b></color>: ver\xE1s
      a Baymax repetir tus movimientos (esta ventana te acompa\xF1a, es de cristal
      y se ve a trav\xE9s). Mueve las manos y la cabeza para comprobarlo.\nCuando
      quieras, pulsa <b>X</b> para seguir."
  - titulo: "\xBFD\xD3NDE EMPIEZO?"
    texto: "Sigue las <b>balizas numeradas</b>:  <b>1</b> Microscopios \xB7 <b>2</b>
      Cepario \xB7 <b>3</b> Alto riesgo (virus en 3D)\nPara recuperar tus recuerdos
      ve al <color=#FFD25A><b>4 \xB7 CENTRO DE EXPERIMENTACI\xD3N</b></color> y sigue
      las flechas del suelo hasta el BANCO DE MUESTRAS (MISI\xD3N 1); despu\xE9s
      vienen la MISI\xD3N 2 y el <b>LABORATORIO DE VACUNAS</b> (MISI\xD3N 3). Cada
      misi\xF3n guarda un <b>checkpoint</b>.\nPara la sala de alto riesgo pasa antes
      por la <b>cabina de descontaminaci\xF3n</b> (11 s, qu\xE9date quieto). \xA1Suerte,
      Baymax!"
--- !u!1 &616604855
